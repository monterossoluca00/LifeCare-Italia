<script>
(function(){
  var srcs=window.LC, N=srcs.length;
  var imgs=new Array(N), ready=new Array(N).fill(false), decoded=0;
  var cv=document.getElementById('seq'), ctx=cv.getContext('2d',{alpha:false});
  var film=document.getElementById('film'), pin=film.querySelector('.pin');
  var loader=document.getElementById('loader'), hint=document.getElementById('hint');
  var hdr=document.getElementById('hdr'), vprog=document.getElementById('vprog');
  var vfill=document.getElementById('vfill'), vnum=document.getElementById('vnum');
  var caps=['c1','c2','c3','c4','c5','c6'].map(function(id){return document.getElementById(id)});
  var ranges=[[0,.15],[.15,.33],[.33,.51],[.51,.68],[.68,.85],[.85,1]];
  var cw=0,ch=0,last=-1,dirty=true,hidden=false;

  function sizeCanvas(){
    var dpr=Math.min(window.devicePixelRatio||1,2);
    var w=Math.round(pin.clientWidth*dpr), h=Math.round(pin.clientHeight*dpr);
    if(w!==cv.width||h!==cv.height){cv.width=w;cv.height=h;cw=w;ch=h;last=-1;dirty=true;}
  }
  function nearest(i){
    if(ready[i])return i;
    for(var d=1;d<N;d++){
      if(i-d>=0&&ready[i-d])return i-d;
      if(i+d<N&&ready[i+d])return i+d;
    }
    return -1;
  }
  function paint(i){
    var k=nearest(i); if(k<0)return;
    var img=imgs[k], iw=img.naturalWidth, ih=img.naturalHeight;
    if(!iw)return;
    var s=Math.max(cw/iw,ch/ih), dw=iw*s, dh=ih*s;
    ctx.drawImage(img,(cw-dw)/2,(ch-dh)/2,dw,dh);
    last=k;
  }
  function ease(t){return t<0?0:t>1?1:t}
  function capOpacity(p,a,b,first){
    var span=b-a, t=(p-a)/span;
    if(t<0||t>1)return 0;
    var fi=.22, fo=.80;
    if(t<fi)return first?1:ease(t/fi);
    if(t>fo)return ease((1-t)/(1-fo));
    return 1;
  }
  function progress(){
    var total=film.offsetHeight-window.innerHeight;
    if(total<=0)return 0;
    var top=film.getBoundingClientRect().top;
    var p=-top/total;
    return p<0?0:p>1?1:p;
  }
  function render(){
    if(dirty){
      dirty=false;
      var p=progress();
      var idx=Math.min(N-1,Math.round(p*(N-1)));
      if(idx!==last)paint(idx);
      for(var i=0;i<caps.length;i++){
        var o=capOpacity(p,ranges[i][0],ranges[i][1],i===0);
        var el=caps[i];
        if(el._o!==o){
          el._o=o;
          el.style.opacity=o;
          var y=(1-o)*10;
          if(el.classList.contains('center'))el.style.transform='translate(-50%,calc(-50% + '+y+'px))';
          else if(el.classList.contains('low'))el.style.transform='translate(-50%,'+y+'px)';
          else el.style.transform='translateY(calc(-50% + '+y+'px))';
        }
      }
      hint.style.opacity=p>.03?0:1;
      vfill.style.height=(p*100)+'%';
      vnum.textContent=String(Math.min(6,Math.floor(p*6)+1)).padStart(2,'0');
      vprog.classList.toggle('on',p>.02&&p<.995);
      hdr.classList.toggle('solid',window.scrollY>60);
    }
    requestAnimationFrame(render);
  }
  function mark(){dirty=true}

  function hideLoader(){
    if(hidden)return; hidden=true;
    sizeCanvas(); paint(0); dirty=true;
    loader.classList.add('gone');
    setTimeout(function(){loader.style.display='none'},1000);
  }

  // decode frames progressively
  srcs.forEach(function(src,i){
    var im=new Image();
    im.decoding='async';
    im.onload=function(){
      ready[i]=true; decoded++;
      if(i===0||decoded===1)dirty=true;
      if(decoded>=30)hideLoader();
    };
    im.onerror=function(){decoded++; if(decoded>=30)hideLoader();};
    im.src=src;
    imgs[i]=im;
  });
  setTimeout(function(){ if(ready[0]||decoded>0) hideLoader(); },4000);
  setTimeout(hideLoader,9000);

  sizeCanvas();
  window.addEventListener('scroll',mark,{passive:true});
  window.addEventListener('resize',function(){sizeCanvas();mark()});
  requestAnimationFrame(render);

  // smooth anchors
  document.querySelectorAll('a[href^="#"]').forEach(function(a){
    a.addEventListener('click',function(e){
      var t=document.querySelector(a.getAttribute('href'));
      if(t){e.preventDefault();t.scrollIntoView({behavior:'smooth',block:'start'})}
    });
  });

  // quote form -> mailto to the operations desk
  document.getElementById('lcForm').addEventListener('submit',function(e){
    e.preventDefault();
    var f=e.target;
    var from=f.from.value.trim(), to=f.to.value.trim();
    if(!from||!to||!f.tel.value.trim()){
      document.getElementById('fnote').textContent='Compilate partenza, destinazione e telefono: senza quei tre dati non possiamo calcolare nulla.';
      return;
    }
    var body='Richiesta di preventivo — trasporto sanitario\n\n'
      +'Partenza: '+from+'\n'
      +'Destinazione: '+to+'\n'
      +'Data prevista: '+(f.data.value||'da definire')+'\n'
      +'Telefono: '+f.tel.value+'\n\n'
      +'Condizioni del paziente (aggiungere qui): ';
    window.location.href='mailto:centrale@lifecare-roma.it?subject='
      +encodeURIComponent('Preventivo trasporto sanitario — '+from+' > '+to)
      +'&body='+encodeURIComponent(body);
    document.getElementById('fnote').textContent='Abbiamo aperto il vostro programma di posta con la richiesta già compilata: premete Invia per inoltrarla alla centrale.';
  });
})();
</script>

</body>
</html>
